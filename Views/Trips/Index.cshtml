@model IEnumerable<Eagle.Models.Trip>

@{
    ViewData["Title"] = "Trips Index";
}

<main class="main">

    <!-- Trips Index Section -->
    <section id="trips-index" class="section">

        <!-- Section Title -->
        <div class="container section-title text-center" data-aos="fade-up">
            <h2 class="display-4 fw-bold text-primary">@ViewData["Title"]</h2>
            <p class="lead text-muted">Manage your trips below or create a new one.</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Create New Trip Button -->
            <div class="row mb-4">
                <div class="col-md-12 text-center">
                    <a asp-action="Create" class="btn btn-success shadow-sm px-5">Create New Trip</a>
                </div>
            </div>

            <!-- Trips Cards -->
            <div class="row justify-content-center">
                @if (!Model.Any())
                {
                    <div class="col-lg-10">
                        <div class="alert alert-info text-center">No trips available. Click "Create New Trip" to add one.</div>
                    </div>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-10 mb-4">
                            <div class="card border-0 shadow-lg">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title fw-bold text-dark mb-2">@item.Name</h5>
                                            <p class="card-text text-muted mb-1">@item.Description</p>
                                            <p class="card-text text-muted mb-2">
                                                <i class="bi bi-calendar"></i> <strong>@item.StartDate.ToString("MMM dd, yyyy")</strong> - <strong>@item.EndDate.ToString("MMM dd, yyyy")</strong>
                                            </p>
                                            <p class="text-muted mb-0"><i class="bi bi-clock"></i> Duration: <strong>@item.StartTime</strong> - <strong>@item.EndTime</strong></p>
                                        </div>
                                        <div class="text-end">
                                            <h4 class="text-success fw-bold mb-2">@item.Price.ToString("C")</h4>
                                            <p class="text-muted mb-0">via @item.Section.Name</p>
                                        </div>
                                    </div>
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="card-footer bg-white text-end border-0">
                                        <a asp-action="Edit" asp-route-id="@item.TripId" class="btn btn-outline-primary btn-sm px-4 py-2 shadow-sm">Edit</a>
                                        <a asp-action="Details" asp-route-id="@item.TripId" class="btn btn-outline-secondary btn-sm px-4 py-2 shadow-sm">Details</a>
                                        <a asp-action="Delete" asp-route-id="@item.TripId" class="btn btn-outline-danger btn-sm px-4 py-2 shadow-sm">Delete</a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div><!-- End Trips Cards -->

        </div>

    </section><!-- /Trips Index Section -->
    <br />
   

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
