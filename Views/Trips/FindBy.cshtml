@using Eagle.Models.ViewModel
@model TripsViewModel

@{
    ViewData["Title"] = "Find Trips";
}

<main class="main">

    <!-- Find Trips Section -->
    <section id="find-trips" class="contact section">

        <!-- Section Title -->
        <div class="container section-title text-center py-5" data-aos="fade-up">
            <h2 class="display-4 fw-bold">@ViewData["Title"]</h2>
            <p class="lead text-muted">Use the filters below to search for trips that meet your criteria. Quickly find the best options for your travel plans.</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Search Form -->
            <div class="row justify-content-center mb-5">
                <div class="col-lg-8">
                    <div class="d-flex justify-content-center mb-3">
                        <a asp-action="FindBy" asp-route-name="Cheapest" class="btn btn-outline-info mx-2">Cheapest</a>
                        <a asp-action="FindBy" asp-route-name="Best" class="btn btn-outline-info mx-2">Best</a>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="text-center mb-4">
                            <a asp-action="Create" class="btn btn-outline-primary shadow-sm px-4 me-2">Create New Trip</a>
                            <a asp-action="Index" asp-controller="Trips" class="btn btn-outline-secondary shadow-sm px-4">Show All</a>
                        </div>
                    }
                    <section class="p-4 rounded shadow-sm bg-white border">
                        <form asp-action="FindBy" method="post" data-aos="fade-up" data-aos-delay="200">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Name" class="form-control" aria-label="Name" />
                                        <label asp-for="Name" class="form-label">From</label>
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Description" class="form-control" aria-label="Description" />
                                        <label asp-for="Description" class="form-label">To</label>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="StartDate" class="form-control" type="date" aria-label="Start Date" />
                                        <label asp-for="StartDate" class="form-label">Start Date</label>
                                        <span asp-validation-for="StartDate" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="EndDate" class="form-control" type="date" aria-label="End Date" />
                                        <label asp-for="EndDate" class="form-label">End Date</label>
                                        <span asp-validation-for="EndDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-floating">
                                        <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" aria-label="Max Price" />
                                        <label asp-for="Price" class="form-label">Max Price</label>
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-12 text-center mt-4">
                                    <button type="submit" class="btn btn-success w-100 py-2 btn-lg">Search Trips</button>
                                </div>
                            </div>
                        </form>
                    </section>
                </div>
            </div><!-- End Search Form -->
            <!-- Trips Cards -->
            <div class="row justify-content-center">
                @if (Model is null || Model.Trips is null || !Model.Trips.Any())
                {
                    <div class="col-lg-10">
                        <div class="alert alert-info text-center">No Trips found!</div>
                    </div>
                }
                else
                {
                    <p class="text-center mb-4">Total Trips Found: <strong>@Model.Trips.Count()</strong></p>
                    @foreach (var trip in Model.Trips)
                    {
                        <div class="col-lg-8 mb-4">
                            <div class="card shadow-lg border-0">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="card-title fw-bold text-primary mb-2">@trip.Name - @trip.Description</h5>
                                            <p class="card-text text-muted mb-1">
                                                <i class="bi bi-calendar"></i> <strong>@trip.StartDate.ToShortDateString()</strong> - <strong>@trip.EndDate.ToShortDateString()</strong>
                                            </p>
                                            <p class="card-text text-muted mb-1">
                                                <i class="bi bi-clock"></i> Duration: <strong>@trip.StartTime</strong> - <strong>@trip.EndTime</strong>
                                            </p>
                                        </div>
                                        <div class="text-end">
                                            <h4 class="text-success fw-bold mb-0">@trip.Price.ToString("C")</h4>
                                            <p class="text-muted mb-0">via @trip.Section.Name</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent text-end border-0">
                                    <a href="#" class="btn btn-primary btn-sm">View Deal</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div><!-- End Trips Cards -->
            <!-- Back to List Button -->
            <div class="row mt-4">
                <div class="col-lg-12 text-center">
                    <a asp-action="Index" asp-controller="Sections" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div><!-- End Back to List Button -->

        </div>

    </section><!-- /Find Trips Section -->

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
