@model Eagle.Models.Section

@{
    ViewData["Title"] = "Delete";
}

<main class="main">

    <!-- Delete Section -->
    <section id="delete-section" class="contact section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>@ViewData["Title"]</h2>
            <p>Are you sure you want to delete this section?</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row gy-4 justify-content-center">

                <div class="col-lg-5">
                    <section>
                        <h4>Section Details</h4>
                        <hr />
                        <dl class="row">
                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>
                        </dl>

                        <form asp-action="Delete" method="post" data-aos="fade-up" data-aos-delay="200">
                            <input type="hidden" asp-for="SectionId" />

                            <div class="text-center">
                                <button type="submit" class="btn btn-outline-danger w-100">Delete</button>
                            </div>

                            <div class="text-center mt-3">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
                            </div>
                        </form>
                    </section>
                </div>

            </div>

        </div>

    </section><!-- /Delete Section -->
    <br />
    <br />
    <br />
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
