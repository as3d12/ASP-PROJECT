@model Eagle.Models.Section



<main class="main">

    <!-- Create Section -->
    <section id="create-section" class="contact section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>@ViewData["Title"]</h2>
            <p>Please fill out the form to create a new section.</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row gy-4 justify-content-center">

                <div class="col-lg-5">
                    <section>
                        <form asp-action="Create" method="post" data-aos="fade-up" data-aos-delay="200">
                            <hr />
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Name" class="form-control" placeholder="Section Name" />
                                <label asp-for="Name" class="form-label">Name</label>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-outline-success w-100">Create</button>
                            </div>

                            <div class="text-center mt-3">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
                            </div>
                        </form>
                    </section>
                </div>

            </div>

        </div>

    </section><!-- /Create Section -->
    <br />
    <br />
    <br />
    <br />
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
