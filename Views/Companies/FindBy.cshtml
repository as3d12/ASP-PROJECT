@model CompaniesViewModel
@{
    ViewData["Title"] = "Find Companies";
}


<main class="main">

    <!-- Find Trips Section -->
    <section id="find-companies" class="contact section">

        <!-- Section Title -->
        <div class="container section-title text-center py-5" data-aos="fade-up">
            <h2 class="display-4 fw-bold">@ViewData["Title"]</h2>
            <p class="lead text-muted">Use the filters below to search for companies.</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Search Form -->
            <div class="row justify-content-center mb-5">
                <div class="col-lg-8">
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="text-center mb-4">
                            <a asp-action="Create" class="btn btn-outline-primary shadow-sm px-4 me-2">Add New Company</a>
                        </div>
                    }
                    <section class="p-4 rounded shadow-sm bg-white border">
                        <form asp-action="FindBy" method="post" data-aos="fade-up" data-aos-delay="200">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Name" class="form-control" aria-label="Name" />
                                        <label asp-for="Name" class="form-label">Name</label>
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Location" class="form-control" aria-label="Location" />
                                        <label asp-for="Location" class="form-label">Location</label>
                                        <span asp-validation-for="Location" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Email" class="form-control"aria-label="Email" />
                                        <label asp-for="Email" class="form-label">Email</label>
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Phone" class="form-control" aria-label="Phone" />
                                        <label asp-for="Phone" class="form-label">Phone</label>
                                        <span asp-validation-for="Phone" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-12 text-center mt-4">
                                    <button type="submit" class="btn btn-success w-100 py-2 btn-lg">Search Companies</button>
                                </div>
                            </div>
                        </form>
                    </section>
                </div>
            </div><!-- End Search Form -->
            <!-- Trips Cards -->
            <div class="row justify-content-center">
                @if (Model is null || Model.Companies is null || Model.Companies.Count() == 0)
                {
                    <div class="col-lg-10">
                        <div class="alert alert-info text-center">No Companies found!</div>
                    </div>
                }
                else
                {
                    <p class="text-center mb-4">Total Companies Found: <strong>@Model.Companies.Count()</strong></p>
                    @foreach (var company in Model.Companies)
                    {
                        <div class="col-lg-8 mb-4">
                            <div class="card shadow-lg border-0">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="card-title fw-bold text-primary mb-2">@company.Name</h5>
                                            <p class="card-text text-muted mb-1">
                                                <i class="bi bi-calendar"></i>Location: <strong>@company.Location</strong>
                                            </p>
                                            <p class="card-text text-muted mb-1">
                                                <i class="bi bi-clock"></i> Phone: <strong>@company.Phone</strong>
                                            </p>
                                            <p class="card-text text-muted mb-1">
                                                <i class="bi bi-clock"></i> Email: <strong>@company.Email</strong>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent text-end border-0">
                                    <a asp-action="Details" asp-route-id="@company.CompanyId" class="btn btn-primary btn-sm">View Deal</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div><!-- End Trips Cards -->
            <!-- Back to List Button -->
            <div class="row mt-4">
                <div class="col-lg-12 text-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div><!-- End Back to List Button -->

        </div>

    </section><!-- /Find Trips Section -->

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

