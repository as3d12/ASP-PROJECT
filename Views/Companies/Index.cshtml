@model IEnumerable<Eagle.Models.Company>

@{
    ViewData["Title"] = "Companies Index";
}

<main class="main">

    <!-- Companies Index Section -->
    <section id="companies-index" class="section bg-light py-5">

        <!-- Section Title -->
        <div class="container section-title text-center mb-5" data-aos="fade-up">
            <h2 class="display-4 fw-bold text-primary">@ViewData["Title"]</h2>
            <p class="lead text-muted">Efficiently manage your companies or start by adding a new one.</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Create New Company Button -->
            <div class="row mb-4">
                <div class="col-md-12 text-center">
                    <a asp-action="Create" class="btn btn-success shadow-sm px-5">Create New Company</a>
                </div>
            </div>

            <!-- Companies Grid -->
            <div class="row justify-content-center">
                @if (!Model.Any())
                {
                    <div class="col-lg-10">
                        <div class="alert alert-info text-center">No companies available. Click "Create New Company" to add one.</div>
                    </div>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-6 col-xl-4 mb-4">
                            <div class="card border-0 shadow-lg h-100">
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-3">
                                        <h5 class="card-title fw-bold text-dark mb-2">@item.Name</h5>
                                        <p class="card-text text-muted mb-1"><i class="bi bi-geo-alt-fill"></i> @item.Location</p>
                                        <p class="card-text text-muted mb-1"><i class="bi bi-envelope-fill"></i> @item.Email</p>
                                        <p class="card-text text-muted mb-3"><i class="bi bi-telephone-fill"></i> @item.Phone</p>
                                    </div>
                                    <div class="mt-auto text-end">
                                        @if (User.IsInRole(clsRoles.roleAdmin))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.CompanyId" class="btn btn-outline-primary btn-sm px-4 py-2 shadow-sm me-2">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.CompanyId" class="btn btn-outline-secondary btn-sm px-4 py-2 shadow-sm me-2">Details</a>
                                            <a asp-action="Delete" asp-route-id="@item.CompanyId" class="btn btn-outline-danger btn-sm px-4 py-2 shadow-sm">Delete</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div><!-- End Companies Grid -->

        </div>
        <br />
        <br />
        <br />
        <br />
    </section><!-- /Companies Index Section -->
  

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
