@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<main class="main">

    <!-- Forgot Password Confirmation Section -->
    <section id="forgot-password-confirmation" class="forgot-password-confirmation section text-center">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2 class="display-4">@ViewData["Title"]</h2>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row justify-content-center">

                <div class="col-lg-6">
                    <section>
                        <div class="confirmation-message bg-light p-4 rounded shadow-sm" data-aos="fade-up" data-aos-delay="200">
                            <p class="lead">
                                Please check your email to reset your password. If you do not receive an email, please check your spam folder or try again.
                            </p>
                        </div>
                    </section>
                </div>

            </div>

        </div>

    </section><!-- /Forgot Password Confirmation Section -->

</main>
<br />
<br />
<br />
<br />
<br />
<br />
<br />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
